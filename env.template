# 複製為 .env 後填入實際值；請勿提交 .env 到 GitHub。

# 必要：MySQL／TiDB 相容資料庫連線字串。
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:3306/DATABASE

# 必要：至少 32 個隨機字元；請勿使用這個範例字串作為正式值。
JWT_SECRET=replace-with-a-long-random-secret

# 選填：多數雲端 Node.js 主機會自動設定。
PORT=3000

# 選填：僅在保留 Manus OAuth 帳戶登入時設定。
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# 選填：僅在使用 Manus Storage Proxy 時設定。
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# 選填：前端分析設定。
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
